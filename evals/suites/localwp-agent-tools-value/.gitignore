# Golden site state is a rebuilt BUILD ARTIFACT — stock WordPress core plus the
# plugin overlay from each fixture's ../plugins source — regenerated by stack/
# and the reproduce script. Only the fixture-defining inputs are tracked
# (plugins/, dropin/, golden/wp-config.php, golden/plugin-list.json, specs,
# scripts); the built ~79MB core tree and DB dumps are not committed.
fixtures/*/golden/public/
fixtures/*/golden/*.sql
fixtures/*/golden/db.sql

# Python bytecode
__pycache__/
*.pyc
