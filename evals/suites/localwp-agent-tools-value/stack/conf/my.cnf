# Lane H MariaDB config (design §2.4, C0 pin iii).
#
# The socket lives at a Local-shaped, non-default path (deliberately NOT
# /tmp/mysql.sock — design §4.1: putting it at the distro default would let
# a bare `wp` "just work" for arm C0, understating the add-on's real
# friction). A TCP listener on a fixed local port is also on, matching
# Local's own per-site port allocation (design C0 pin iii; exact Local
# range is an open question, §13.6) so C0's `ss -ltnp` + wp-config.php
# credentials path is exercisable.
[mysqld]
socket = /srv/run/SITE_ID/mysql/mysqld.sock
pid-file = /srv/run/SITE_ID/mysql/mysqld.pid
datadir = /srv/run/SITE_ID/mysql/data
bind-address = 127.0.0.1
port = 10003
skip-name-resolve
